          "_name": "article13",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article13\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Content Width\" name=\"contentWidth\" min=\"4\" max=\"12\" step=\"1\" value=\"10\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Wrap Bg\" name=\"wrapBgColor\" value=\"#393193\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n           <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-md-12 col-lg-{{contentWidth}}\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-box\"><b>Contact US</b></h4>\n                        <p class=\"mbr-text mbr-fonts-style mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">1.<br>Police Constable\n<br>police-constable.request@surrey.uscn.org.uk\n<br>\n<br>Police Sergeant\n<br>police-sergeant.request@surrey.uscn.org.uk\n<br>\n<br>Detective Constable\n<br>detective-constable.request@surrey.uscn.org.uk\n<br>\n<br>Detective Sergeant\n<br>detective-sergeant.request@surrey.uscn.org.uk\n<br>\n<br>Detective Inspector\n<br>detective-inspector.request@surrey.uscn.org.uk\n<br>\n<br>Police Community Support Officer (PCSO)\n<br>pcso.request@surrey.uscn.org.uk\n<br>\n<br>Collision Investigator\n<br>collision-investigator.request@surrey.uscn.org.uk\n<br>\n<br>Digital Forensics\n<br>digital-forensics.request@surrey.uscn.org.uk\n<br>\n<br>Police Staff Investigator\n<br>staff-investigator.request@surrey.uscn.org.uk\n<br>\n<br>CCTV / Video Evidence Officer\n<br>video-evidence.request@surrey.uscn.org.uk\n<br>\n<br>Tel: 0330 520 4085<br>\n<br>Data Handling - Data Protection\n<br>\n<br>\n<br>\n<br>2. \n<br>For enquires regarding camera hardware we operate (including logs) contact:\n<br>\n<br>Software Logs\n<br>surrey-police.software-logs@ware.uscn.org.uk\n<br>\n<br>Camera Locations, Manufactures\n<br>surrey-police.hardware@ware.uscn.org.uk\n<br>\n<br>General Information in relation to hard/software \n<br>hws631446@ware.uscn.org.uk\n<br>\n<br>(HSW-General-Mailbox, Surrey-Police)\n<br>\n<br>Tel: 0330 520 4085\n<br>\n<br>(surrey-police.dpo@ware.uscn.org.uk may need to involved when disclosing certain information)\n<br>\n<br>HSW - Hard/Soft Ware.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        Start now\n                        </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vBilh68vFv",
          "_anchor": "article13-8",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "64px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              }
            },
            ".nav-wrapper": {
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              },
              ".list": {
                "margin": "0",
                "padding": "0",
                "list-style-type": "none",
                ".item-wrap": {
                  "margin-bottom": "16px",
                  "transition": "all .3s ease",
                  "&:hover, &:focus": {
                    "opacity": ".5"
                  },
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px",
                "text-align": "left"
              },
              "text-align": "right"
            },
            ".border-wrapper": {
              "border-bottom": "3px dashed @border",
              "margin-bottom": "64px",
              "@media (max-width: 992px)": {
                "margin-bottom": "32px"
              }
            },
            ".mbr-copy": {
              "margin-bottom": "0",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".list": {
              "color": "#ffffff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "holidaym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 holidaym5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Navigation 1\" name=\"showNav_1\" checked>\n        <input type=\"checkbox\" title=\"Navigation 2\" name=\"showNav_2\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/holidaym5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#0c2c68\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/holidaym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#a11a20\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-3\" mbr-if=\"showTitle\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>USCN<br>POLICE&nbsp;<br>INFORMATION</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3\" mbr-if=\"showNav_1\">\n                <div class=\"nav-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><span style=\"font-size: calc(1.14rem + 0.26 * ((100vw - 62rem) / 25));\"><a href=\"https://met.uscn.org.uk\" class=\"text-white\"><b>Met Police</b></a></span></li><li class=\"item-wrap\"><span style=\"font-size: calc(1.14rem + 0.26 * ((100vw - 62rem) / 25));\"><a href=\"https://london.uscn.org.uk\" class=\"text-white text-primary\"><b>London</b></a></span></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3\" mbr-if=\"showNav_2\">\n                <div class=\"nav-wrapper\">\n                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                        <li class=\"item-wrap\"><a href=\"https://surrey.uscn.org.uk\" class=\"text-white\"><b>Surrey Police</b></a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3\" mbr-if=\"showButtons\">\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white-outline\" href=\"mailto:police-info.website-software@ware.uscn.org.uk\" data-app-placeholder=\"Type Text\">Webpage Contact</a></div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"border-wrapper\" mbr-if=\"showBorder\"></div>\n                <p class=\"mbr-copy mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCopy\" data-app-selector=\".mbr-copy\" data-app-placeholder=\"Type Text\">\n                    © Copyright USCN - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vBioxc2WFL",
          "_anchor": "footer01-a",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}