                    }
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "22px",
                  "margin-bottom": "-9.6px"
                }
              }
            },
            ".image-wrapper": {
              "@media (max-width: 992px)": {
                "margin-top": "32px"
              },
              "img": {
                "height": "510px",
                "width": "100%",
                "object-fit": "cover",
                "@media (max-width: 992px)": {
